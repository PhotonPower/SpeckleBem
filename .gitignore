# Build
build/
build-*/
cmake-build-*/
out/
_deps/
CMakeUserPresets.json

# Python
__pycache__/
*.py[cod]
*.so
*.egg-info/
dist/
.venv/
venv/
.pytest_cache/
_skbuild/
wheelhouse/

# IDE / editors
.vscode/
.idea/
*.swp
.DS_Store

# Data / results (keep small reference data under tests/data)
*.h5
*.hdf5
results/
# ...except the curated benchmark records (Markdown tables, docs/01 Phase 2/3 DoD)
!benchmarks/results/
benchmarks/results/*.json
*.log
# ...except the curated raw run logs of a study record (path-free, WP22b2)
!benchmarks/results/wp22b2_logs/*.log
!benchmarks/results/wp_v2b_logs/*.log
!benchmarks/results/wp_v3_logs/*.log
# Run directories of scripts/server_run_kit/run_large_area.sh (sent back as tarballs)
server_runs/

# Secrets — never commit tokens or credentials
*.token
*token*
.env

# Agent worktrees (created by subagents with isolation: worktree)
.claude/worktrees/

# Copyrighted literature (local only, never commit)
docs/papers/
