# Closed tetrahedron, 1 mm edges along the axes (units: metres).
# Exercises comments, ignored statements and the a/b/c, a/b and a//c face forms.
mtllib tetra.mtl
o tetra
v 0 0 0
v 1e-3 0 0
v 0 1e-3 0
v 0 0 1e-3
vt 0 0
vt 1 0
vt 0 1
vn 0 0 -1
vn 0.57735 0.57735 0.57735
g surface
usemtl default
s off
f 1 3 2
f 1/1 2/2 4/3
f 1//1 4//1 3//1
f 2/2/2 3/3/2 4/1/2  # slanted face
