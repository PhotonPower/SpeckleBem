BasedOnStyle: Google
Language: Cpp
Standard: c++20
IndentWidth: 4
ColumnLimit: 100
AccessModifierOffset: -4
AllowShortFunctionsOnASingleLine: Inline
AllowShortIfStatementsOnASingleLine: Never
BreakBeforeBraces: Attach
DerivePointerAlignment: false
PointerAlignment: Left
IncludeBlocks: Regroup
IncludeCategories:
  - Regex: '^"specklebem/'
    Priority: 1
  - Regex: '^<(Eigen|pybind11|catch2)'
    Priority: 3
  - Regex: '^<.*\.h>'
    Priority: 4
  - Regex: '^<'
    Priority: 5
SortIncludes: true
